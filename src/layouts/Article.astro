---
import ArticleRow from "@components/ArticleRow.astro";
import Meta from "@components/Meta.astro";
import PageHeader from "@components/PageHeader.astro";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const { title, description, date, readingTime } = frontmatter;

const articleFiles = import.meta.glob("../pages/writing/*.md", { eager: true });
const related = (Object.values(articleFiles) as any[])
  .filter((article) => article.frontmatter.title !== title)
  .sort(() => 0.5 - Math.random())
  .slice(0, 3);
---

<BaseLayout title={title} description={description} ogType="article">
  <article>
    <PageHeader title={title} align="center">
      <Meta date={date} readingTime={readingTime} class="mt-5" />
    </PageHeader>
    <div class="prose">
      <slot />
    </div>
  </article>

  <section class="mt-24">
    <h2 class="text-meta uppercase tracking-widest text-muted">
      Other things I've written
    </h2>
    <ul class="mt-4 border-b border-line">
      {
        related.map((article) => (
          <ArticleRow
            href={article.url}
            title={article.frontmatter.title}
            date={article.frontmatter.date}
            readingTime={article.frontmatter.readingTime}
          />
        ))
      }
    </ul>
  </section>
</BaseLayout>
