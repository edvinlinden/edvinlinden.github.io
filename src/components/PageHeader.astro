---
export interface Props {
  title: string;
  align?: "left" | "center";
  class?: string;
}

const { title, align = "left", class: className = "" } = Astro.props;
---

<header class={`mb-10 ${align === "center" ? "md:text-center" : ""} ${className}`}>
  <h1
    class="text-[2rem] font-bold leading-[1.1] tracking-tight text-ink md:text-[2.5rem]"
  >
    {title}
  </h1>
  <slot />
</header>
