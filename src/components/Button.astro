---
export interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "quiet";
  external?: boolean;
  id?: string;
  class?: string;
}

const {
  href,
  variant = "primary",
  external = false,
  id,
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center gap-2 text-base font-semibold transition-colors";

const variants = {
  primary: "rounded-lg bg-accent px-4 py-2.5 text-white hover:bg-accent-strong",
  secondary:
    "rounded-lg border border-muted/50 px-4 py-2.5 text-ink hover:border-accent hover:text-accent",
  quiet: "text-accent hover:text-accent-strong",
};

const classes = `${base} ${variants[variant]} ${className}`;
const externalAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} id={id} class={classes} {...externalAttrs}>
      <slot />
    </a>
  ) : (
    <button type="button" id={id} class={classes}>
      <slot />
    </button>
  )
}
