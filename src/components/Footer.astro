---
import GoodbyeOverlay from "@components/GoodbyeOverlay.astro";
import TelemetryDeck from "./TelemetryDeck.astro";
---

<footer class="wrap border-t border-line py-8 text-meta">
  <div class="flex justify-between gap-6">
    <div class="group text-muted">
      <span
        class="inline-block transition-transform duration-300 group-hover:-translate-y-px group-hover:rotate-180"
        >&copy;</span
      > 2026
    </div>
    <nav class="flex gap-4">
      <a
        href="/privacy/"
        title="Privacy"
        class="text-muted transition-colors hover:text-accent"
      >
        Privacy
      </a>
      <a
        href="mailto:hello@edvinlinden.se"
        title="Email"
        class="text-muted transition-colors hover:text-accent"
      >
        Email
      </a>
      <a
        href="https://www.linkedin.com/in/edvin-linden"
        target="_blank"
        title="LinkedIn"
        rel="noopener noreferrer"
        class="text-muted transition-colors hover:text-accent"
      >
        LinkedIn
      </a>
    </nav>
  </div>
  <GoodbyeOverlay />
  <TelemetryDeck />
</footer>
