---
import type { Stat } from "../data/stats";

export interface Props {
    stats: Stat[];
}

const { stats } = Astro.props;
---

<dl
    class="flex flex-col items-center justify-between gap-16 py-8 text-center sm:items-start sm:flex-row"
>
    {
        stats.map((stat) => (
            <div>
                <dt class="text-meta uppercase tracking-widest text-muted">
                    {stat.label}
                </dt>
                <dd class="mt-2 text-[3rem] font-black leading-[1.1] tracking-tight text-ink">
                    {stat.value}
                </dd>
            </div>
        ))
    }
</dl>
