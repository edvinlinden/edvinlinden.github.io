---
import Badge from "./Badge.astro";
import Button from "./Button.astro";

export interface Props {
    title: string;
    href: string;
    linkText: string;
    image: string;
    imageAltText: string;
    years: string;
    badge?: string;
    description: string[];
    external?: boolean;
    /** Puts the screenshot on the right and breaks the card out that way instead. */
    flipped?: boolean;
}

const {
    title,
    href,
    linkText,
    image,
    imageAltText,
    years,
    badge,
    description,
    external = false,
    flipped = false,
} = Astro.props;

const externalAttrs = external
    ? { target: "_blank", rel: "noopener noreferrer" }
    : {};
---

<div
    class:list={[
        "group flex flex-col gap-16 md:gap-16 md:items-center rounded-xl md:[--breakout-offset:24px] md:-mr-6 md:flex-row",
        image ? "md:breakout-left" : "",
    ]}
>
    {
        image && (
            <img
                src={image}
                alt={imageAltText}
                title={imageAltText}
                loading="lazy"
                width="192"
                height="416"
                class:list={[
                    "aspect-[9/19.5] w-full md:w-56 flex-none self-center md:self-start rounded-4xl md:rounded-3xl object-cover object-top shadow-2xl",
                    flipped ? "md:rotate-3" : "md:-rotate-3",
                ]}
            />
        )
    }
    <div>
        <div
            class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between md:gap-4"
        >
            <h3
                class="flex items-center gap-3 text-subhead font-semibold text-ink"
            >
                {title}
                {badge && <Badge>{badge}</Badge>}
            </h3>
            <span
                class="text-meta uppercase tracking-widest text-muted md:whitespace-nowrap"
            >
                {years}
            </span>
        </div>
        {
            description.map((paragraph) => (
                <p class="mt-3 text-lg">{paragraph}</p>
            ))
        }
        <Button
            href={href}
            variant="primary"
            external={external}
            class="mt-8"
            {...externalAttrs}>{linkText}</Button
        >
    </div>
</div>
