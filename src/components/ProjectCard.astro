---
import Badge from "./Badge.astro";

export interface Props {
  title: string;
  href: string;
  image: string;
  years: string;
  badge?: string;
  description: string[];
  external?: boolean;
}

const {
  title,
  href,
  image,
  years,
  badge,
  description,
  external = false,
} = Astro.props;

const externalAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<a
  href={href}
  {...externalAttrs}
  class="group flex flex-col gap-6 rounded-xl transition-colors md:flex-row md:p-6 md:hover:bg-raised"
>
  <img
    src={image}
    alt=""
    loading="lazy"
    width="160"
    height="160"
    class="h-60 w-full flex-none rounded-lg border border-line object-cover md:h-40 md:w-40"
  />
  <div>
    <div
      class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between md:gap-4"
    >
      <h3
        class="flex items-center gap-3 text-subhead font-semibold text-ink transition-colors group-hover:text-accent"
      >
        {title}
        {badge && <Badge>{badge}</Badge>}
      </h3>
      <span class="text-meta uppercase tracking-widest text-muted md:whitespace-nowrap">
        {years}
      </span>
    </div>
    {description.map((paragraph) => <p class="mt-3 text-lg">{paragraph}</p>)}
  </div>
</a>
