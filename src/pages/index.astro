---
import ProjectCard from "@components/ProjectCard.astro";
import Stats from "@components/Stats.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { stats } from "../data/stats";
---

<BaseLayout
    title="Home"
    description="Edvin Lindén has been making small apps for iPhone and iPad for over five years, downloaded more than 125,000 times and used by over 11,000 people every month."
    preloadImage="/images/edvin-linden-2024.webp"
>
    <section
        class="flex flex-col-reverse gap-10 md:flex-row md:items-center lg:gap-12 lg:breakout-right"
    >
        <div class="text-pretty md:min-w-0 md:flex-1">
            <h1 class="text-2xl leading-snug text-ink">
                Hi, my name is Edvin and I have been building small apps for
                over five years.
            </h1>
            <p class="mt-5">
                It always starts the same way. I have a problem, go looking for
                an app to solve it, and everything I try is full of ads, packed
                with features I don't need, or takes ten taps to do one thing.
            </p>
            <p class="mt-5">So I build my own instead.</p>
        </div>
        <img
            src="/images/edvin-linden-2024.webp"
            alt="Image of Edvin Lindén 2024"
            width="360"
            height="450"
            class="aspect-[1/1] w-full rounded-xl object-cover md:aspect-[4/5] md:w-[260px] md:flex-none lg:w-[360px] shadow-2xl md:rotate-3"
        />
    </section>

    <section class="mt-20">
        <Stats stats={stats} />
    </section>

    <section id="projects" class="mt-24 scroll-mt-8">
        <h2 class="text-meta uppercase tracking-widest text-muted">Projects</h2>
        <div class="mt-8 flex flex-col gap-6 md:-mx-6">
            {projects.map((project) => <ProjectCard {...project} />)}
        </div>
    </section>
</BaseLayout>
