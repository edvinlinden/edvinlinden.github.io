---
import ArticleRow from "@components/ArticleRow.astro";
import PageHeader from "@components/PageHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const matches = import.meta.glob("./*.md", { eager: true });
const articles = (Object.values(matches) as any[]).sort(
  (a, b) =>
    new Date(b.frontmatter.date).valueOf() -
    new Date(a.frontmatter.date).valueOf()
);
---

<BaseLayout
  title="Things I've written"
  description="Things written by Edvin Lindén, mostly about side projects such as app development."
>
  <PageHeader title="Things I've written" />

  <ul class="border-b border-line">
    {
      articles.map((article) => (
        <ArticleRow
          href={article.url}
          title={article.frontmatter.title}
          date={article.frontmatter.date}
          readingTime={article.frontmatter.readingTime}
        />
      ))
    }
  </ul>
</BaseLayout>
