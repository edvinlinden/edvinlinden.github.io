---
import Button from "@components/Button.astro";
import PageHeader from "@components/PageHeader.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const marquee = Array.from({ length: 6 }, () => "404 — page not found");
---

<BaseLayout
  title="Page not found"
  description="I'm sorry, but you seem to have come to the wrong place."
>
  <PageHeader title="Page not found" />

  <div class="prose">
    <p>I'm sorry, but you seem to have come to the wrong place.</p>
    <p>
      The page you are looking for have either been moved, deleted or never
      existed at all.
    </p>
  </div>

  <div
    class="mt-10 flex overflow-x-hidden rounded-lg bg-ink py-2 text-meta uppercase tracking-widest text-surface"
    aria-hidden="true"
  >
    <div class="relative">
      <ul class="flex animate-marquee whitespace-nowrap">
        {marquee.map((text) => <li class="mx-4">{text}</li>)}
      </ul>
      <ul class="absolute top-0 flex animate-marquee2 whitespace-nowrap">
        {marquee.map((text) => <li class="mx-4">{text}</li>)}
      </ul>
    </div>
  </div>

  <Button href="/" variant="secondary" class="mt-10">Back to the start</Button>
</BaseLayout>
