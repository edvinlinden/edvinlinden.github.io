---
import AppStoreBadge from "@components/AppStoreBadge.astro";
import PageHeader from "@components/PageHeader.astro";
import StarRating from "@components/StarRating.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
    appName,
    appStoreUrl,
    appSummary,
    developer,
    difficulties,
    difficultyIntro,
    faqs,
    features,
    languages,
    pageDescription,
    pageTitle,
    promises,
    rating,
    reviews,
    screenshots,
} from "../../data/sudoku";

const [hero] = screenshots;

const ratingDisplay = rating.value.toFixed(1);

const illustrationFile = (name: string) =>
    `${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}.png`;

const structuredData = [
    {
        "@context": "https://schema.org",
        "@type": "MobileApplication",
        name: appName,
        alternateName: "Sudoku",
        applicationCategory: "GameApplication",
        applicationSubCategory: "Puzzle",
        operatingSystem: "iOS 18.6, iPadOS 18.6",
        url: "https://edvinlinden.se/sudoku/",
        downloadUrl: appStoreUrl,
        installUrl: appStoreUrl,
        description: pageDescription,
        inLanguage: ["en", "de", "es", "fr", "ja", "sv"],
        contentRating: "4+",
        fileSize: "6 MB",
        datePublished: "2026-01-26",
        image: "https://edvinlinden.se/images/sudoku/sudoku-no-ads-unlimited-by-edvin-linden-app-icon.webp",
        screenshot: screenshots.map(
            (shot) => `https://edvinlinden.se${shot.src}`,
        ),
        featureList: [...promises, ...features].map(
            (item) => `${item.name}: ${item.detail}`,
        ),
        author: {
            "@type": "Person",
            name: developer.name,
            url: `https://edvinlinden.se${developer.profilePath}`,
            image: `https://edvinlinden.se${developer.portrait}`,
        },
        offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "USD",
            availability: "https://schema.org/InStock",
        },
        privacyPolicy: "https://edvinlinden.se/sudoku/privacy/",
        aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: ratingDisplay,
            ratingCount: rating.count,
            bestRating: "5",
            worstRating: "1",
        },
        review: reviews.map((review) => ({
            "@type": "Review",
            name: review.title,
            reviewBody: review.body,
            author: { "@type": "Person", name: review.author },
            reviewRating: {
                "@type": "Rating",
                ratingValue: String(review.rating),
                bestRating: "5",
                worstRating: "1",
            },
        })),
    },
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faqs.map((faq) => ({
            "@type": "Question",
            name: faq.q,
            acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
    },
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Edvin Lindén",
                item: "https://edvinlinden.se/",
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "Sudoku",
                item: "https://edvinlinden.se/sudoku/",
            },
        ],
    },
];
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    markdownUrl="/sudoku.md"
>
    <meta slot="head" name="apple-itunes-app" content="app-id=6757938217" />
    <section class="flex flex-col gap-10 md:flex-row md:items-center lg:gap-12 lg:breakout-right">
        <div class="text-pretty md:min-w-0 md:flex-1">
            <PageHeader title="Free Sudoku App for iPhone & iPad – No Ads, No Account">
                <p class="mt-5">{appSummary}</p>
                <p class="mt-5">
                    Five difficulty levels, from an easy first puzzle to one
                    that will genuinely hold you up.
                </p>
                <p class="mt-5">
                    I built it because I played a lot of Sudoku on my phone, but
                    every app I tried was either full of ads or wanted money
                    before I could start a puzzle. I wanted something simpler.
                </p>
            </PageHeader>
            <AppStoreBadge
                href={appStoreUrl}
                placement="hero"
                alt="Download Sudoku – No Ads, Unlimited on the App Store"
                class="mt-8"
            />
            <p class="mt-8 md:mt-4 flex flex-col-reverse md:flex-row flex-wrap items-center justify-center gap-2 text-base md:justify-start text-muted">
                <StarRating rating={rating.value} size={16} />
                <span>{ratingDisplay} out of 5 on the App Store</span>
            </p>
        </div>
        <img
            src={hero.src}
            alt={hero.alt}
            width={hero.width}
            height={hero.height}
            fetchpriority="high"
            class="hidden md:block mx-auto w-[320px] rounded-3xl shadow-2xl md:mx-0 md:w-[260px] md:flex-none md:-rotate-3 md:rounded-3xl lg:w-[320px]"
        />
    </section>

    <section class="mt-20">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            Features designed for distraction-free play
        </h2>
        <ul class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:breakout-left lg:breakout-right">
            {features.map((feature) => (
                <li class="rounded-2xl bg-raised p-5">
                    <div
                        class:list={[
                            "aspect-square overflow-hidden",
                            feature.illustration
                                ? ""
                                : "border-2 border-dashed border-shaded",
                        ]}
                    >
                        {feature.illustration ? (
                            <img
                                src={feature.illustration}
                                alt={feature.illustrationAlt ?? ""}
                                loading="lazy"
                                class="h-full w-full object-contain"
                            />
                        ) : (
                            <p class="flex h-full flex-col items-center justify-center px-4 text-center font-mono text-meta leading-relaxed text-muted">
                                <span class="text-shaded">
                                    /images/sudoku/features/
                                </span>
                                <span class="break-all">
                                    {illustrationFile(feature.name)}
                                </span>
                                <span class="mt-1">1200 × 1200</span>
                            </p>
                        )}
                    </div>
                    <div class="mt-5">
                        <p class="text-lg font-semibold text-ink">
                            {feature.name}
                        </p>
                        <p class="mt-1 text-base text-muted">
                            {feature.detail}
                        </p>
                    </div>
                </li>
            ))}
        </ul>
    </section>

    <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            Built to stay out of the way
        </h2>
        <dl class="mt-8 border-b border-line">
            {promises.map((promise) => (
                <div class="grid gap-x-10 gap-y-1 border-t border-line py-6 md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:items-baseline md:py-7">
                    <dt class="text-[1.75rem] font-bold leading-[1.1] tracking-tight text-ink md:text-[2.25rem]">
                        {promise.name}
                    </dt>
                    <dd class="text-pretty text-lg text-muted">
                        {promise.detail}
                    </dd>
                </div>
            ))}
        </dl>
    </section>

    <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            Reviews on the App Store
        </h2>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
            <p class="text-[3rem] font-black leading-none tracking-tight text-ink">
                {ratingDisplay}
            </p>
            <div>
                <StarRating rating={rating.value} size={22} />
                <p class="mt-2 text-base text-muted">
                    {rating.count} ratings on the App Store
                </p>
            </div>
        </div>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:breakout-left lg:breakout-right">
            {reviews.map((review) => (
                <li class="flex flex-col rounded-2xl bg-raised p-5">
                    <StarRating rating={review.rating} size={15} />
                    <p class="mt-4 text-lg font-semibold text-ink">
                        {review.title}
                    </p>
                    <blockquote class="mt-2 text-base text-muted">
                        {review.body}
                    </blockquote>
                    <p class="mt-auto pt-5 text-meta uppercase tracking-widest text-muted">
                        {review.author}
                    </p>
                </li>
            ))}
        </ul>
        <AppStoreBadge
            href={appStoreUrl}
            placement="reviews"
            alt="Download Sudoku – No Ads, Unlimited on the App Store"
            class="mt-10"
        />
    </section>

    <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            Plays in six languages
        </h2>
        <p class="mt-3 text-lg">
            Every menu, hint and statistic is translated. Sudoku follows
            whichever language the device is set to.
        </p>
        <ul class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 md:grid-cols-3">
            {languages.map((language) => (
                <li class="flex items-center gap-4 bg-surface px-5 py-4">
                    <span class="text-5xl leading-none" aria-hidden="true">
                        {language.flag}
                    </span>
                    <span>
                        <span class="block text-lg font-semibold text-ink">
                            {language.endonym}
                        </span>
                        {language.endonym !== language.name && (
                            <span class="block text-meta uppercase tracking-widest text-muted">
                                {language.name}
                            </span>
                        )}
                    </span>
                </li>
            ))}
        </ul>
    </section>

    <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            iPhone and iPad
        </h2>
        <p class="mt-3 text-lg">
            The same app on both, laid out for the screen it is on. iCloud keeps
            the board and the statistics in step, so a puzzle started on a phone
            can be finished on an iPad.
        </p>
        <dl class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
            <div class="bg-surface px-5 py-4">
                <dt class="text-lg font-semibold text-ink">iPhone</dt>
                <dd class="text-meta uppercase tracking-widest text-muted">
                    iOS 18.6 or later
                </dd>
            </div>
            <div class="bg-surface px-5 py-4">
                <dt class="text-lg font-semibold text-ink">iPad</dt>
                <dd class="text-meta uppercase tracking-widest text-muted">
                    iPadOS 18.6 or later
                </dd>
            </div>
        </dl>
        <AppStoreBadge
            href={appStoreUrl}
            placement="platforms"
            alt="Download Sudoku – No Ads, Unlimited on the App Store"
            class="mt-8"
        />
    </section>

    <section id="difficulty" class="mt-24 scroll-mt-8">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            How the difficulty levels work
        </h2>
        <p class="mt-3 text-lg">{difficultyIntro}</p>
        <ol class="mt-8 border-b border-line">
            {difficulties.map((difficulty) => (
                <li class="grid gap-x-10 gap-y-2 border-t border-line py-6 md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)] md:items-baseline">
                    <h3 class="text-subhead font-semibold text-ink">
                        {difficulty.name}
                    </h3>
                    <p class="text-pretty text-lg">{difficulty.detail}</p>
                </li>
            ))}
        </ol>
    </section>

    <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            Questions about the app
        </h2>
        <dl class="mt-8">
            {faqs.map((faq) => (
                <div class="border-t border-line py-6">
                    <dt class="text-subhead font-semibold text-ink">{faq.q}</dt>
                    <dd class="mt-2 space-y-3 text-lg">
                        {faq.a.split("\n\n").map((paragraph) => (
                            <p>{paragraph}</p>
                        ))}
                        {faq.link && (
                            <p>
                                <a class="link" href={faq.link.path}>
                                    {faq.link.label}
                                </a>
                            </p>
                        )}
                    </dd>
                </div>
            ))}
        </dl>
    </section>

    <section class="mt-16 flex flex-col gap-6 sm:flex-row sm:items-center">
        <img
            src={developer.portrait}
            alt={`Portrait of ${developer.name}`}
            width="144"
            height="144"
            loading="lazy"
            class="size-28 mx-auto md:mx-0 flex-none rounded-full sm:size-36"
        />
        <div class="text-pretty">
            <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
                Built by {developer.name}
            </h2>
            <p class="mt-3 text-lg">{developer.bio}</p>
            <p class="mt-3 text-lg">
                <a class="link" href={developer.appsPath}>
                    See more of my apps
                </a>
            </p>
        </div>
    </section>

    <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight text-ink md:text-[1.75rem]">
            Get Sudoku
        </h2>
        <p class="mt-3 text-lg">
            Free on the App Store, for iPhone and iPad. No ads, no account,
            nothing to cancel.
        </p>
        <AppStoreBadge
            href={appStoreUrl}
            placement="closing"
            alt="Download Sudoku – No Ads, Unlimited on the App Store"
            class="mt-8"
        />
    </section>

    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(structuredData)}
    />
</BaseLayout>
